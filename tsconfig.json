{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",                                  
    "module": "commonjs",                                
    "lib": ["es2020"],                                   

    /* Modules */
    "rootDir": "./",                                     
    "moduleResolution": "node",                         
    "baseUrl": "./",                                     
    "paths": {
      "*": ["node_modules/*"]
    },

    /* Emit */
    "outDir": "./dist",                                  
    "removeComments": true,                              
    "noEmitOnError": true,                               

    /* Interop Constraints */
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            

    /* Type Checking */
    "strict": true,                                      
    "noImplicitAny": true,                               
    "skipLibCheck": true                                 
  },
  "include": [
    "apps/server/src/**/*" 
  ],
  "exclude": [
    "node_modules",
    "apps/mobile" 
  ]
}