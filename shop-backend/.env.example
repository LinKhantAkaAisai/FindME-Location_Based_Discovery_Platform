# ============================================
# SHOP FINDER BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️ The server will NOT start without a valid .env
# ============================================

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# JWT Secret (generate a strong random key, at least 32 chars)
# You can generate one with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_YOUR_SECRET

# Server
PORT=3000
API_BASE_URL=http://YOUR_IP:3000
